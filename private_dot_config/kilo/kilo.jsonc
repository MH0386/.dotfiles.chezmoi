{
  "$schema": "https://app.kilo.ai/config.json",
  "code_edit_display": "expanded",
  "experimental": {
    "batch_tool": true,
    "codebase_search": true,
    "continue_loop_on_deny": true,
    "native_notebook_tools": true,
    "swe_pruner": true
  },
  "indexing": {
    "enabled": true,
    "model": "mistralai/mistral-embed-2312",
    "provider": "kilo"
  },
  "permission": {
    "bash": "allow",
    "external_directory": {
      "/tmp/*": "allow"
    }
  },
  "plugin": [
    "opencode-wakatime",
    "@dietrichgebert/ponytail"
  ],
  "remote_control": true,
  "sandbox": {
    "enabled": true
  },
  "auto_collapse_reasoning": false,
  "terminal_command_display": "expanded",
  "compaction": {
    "auto": true
  }
}